# jiku-github-sync — environment variables. Copy to .env (ignored by git) and fill in.
# The example values are those of Jiku's local stack; in production they all change.

# ---- Jiku bus (the names of Jiku's connector SDKs) ----------------------------------------
# NATS URL. The local compose sets it to nats://nats:4222 (jiku-local_jiku network).
JIKU_SERVERS=nats://localhost:4222
# Installation: dev / prod (Jiku's NATS_INSTANCE).
JIKU_INSTANCE=dev
# Sentinel creds: they grant nothing on their own, they trigger the auth-callout.
JIKU_CREDS=../../jiku/deploy/nats/creds/sentinel-client.creds
# Request timeout on the bus.
JIKU_TIMEOUT=15s

# ---- Identity: the connector's own machine user ---------------------------------------------
# Zitadel machine user with the `internal-app` role and Access Token Type = JWT. Its JSON key,
# either as a path or base64 (base64 -w0 key.json). Never commit it.
JIKU_KEY_FILE=
JIKU_KEY_B64=
JIKU_ISSUER=https://id.grava.io
# Zitadel project id: it is what puts the roles in the token.
JIKU_PROJECT_ID=

# ---- GitHub ----------------------------------------------------------------------------------
# Token with access to the mapped repos and Projects: a GitHub App installation token in
# production; for a trial, a token with `repo` + `project`. Everything the connector writes on
# GitHub appears under this identity.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
# Secret of the GitHub App webhook. Empty: the receiver (/webhooks/github) is disabled and
# changes are picked up by polling only.
GITHUB_WEBHOOK_SECRET=

# ---- Sync ------------------------------------------------------------------------------------
# Mapping file (see config.example.yaml). Reloaded while running when it changes.
SYNC_CONFIG=config.yaml
SYNC_CONFIG_RELOAD=30s
# How often GitHub is polled for issues, comments and Project item values.
SYNC_POLL_INTERVAL=60s
# Full pass over every linked pair, catching whatever a lost event or poll missed.
SYNC_RECONCILE_INTERVAL=15m
# Minimum gap between content-creating writes on GitHub (its limit: 80/min, 500/hour).
SYNC_WRITE_INTERVAL=1s
# kv (the connector's space in Jiku's KV, default) or memory (trials: nothing survives a restart).
SYNC_STATE=kv
# Durable consumer name for Jiku's events. Empty (default): ephemeral consumer. A durable one
# needs the role to be allowed to ack JetStream messages, which `internal-app` is not today.
SYNC_EVENTS_DURABLE=

# ---- Operations ------------------------------------------------------------------------------
# /healthz, /readyz and /webhooks/github.
SYNC_HTTP_ADDR=:8080
# debug, info, warn, error
LOG_LEVEL=info

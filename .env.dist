# jiku-github-sync — environment variables. Copy to .env (ignored by git) and fill in.
# The bus (Jiku), identity (Zitadel) and GitHub settings are added as the connector grows.

# ---- Operations --------------------------------------------------------------------------
# /healthz and /readyz (and, in v1, the GitHub webhook receiver).
SYNC_HTTP_ADDR=:8080
# debug, info, warn, error
LOG_LEVEL=info
